# ---------------------------------------------------------------- Neo4j
# Docker local:   bolt://localhost:7687
# Neo4j Aura:     neo4j+s://xxxxxxx.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USUARIO=neo4j
NEO4J_CLAVE=cambiar
NEO4J_BASE=neo4j

# ---------------------------------------------------------------- Modelo de lenguaje
# proveedor: gemini | groq | deepseek | ollama
# gemini   -> Google AI Studio, tier gratuito: https://aistudio.google.com/apikey
# groq     -> https://console.groq.com  (es el que usaron S1 y S2 en el PI4)
# deepseek -> https://platform.deepseek.com  (el que usó S3)
# ollama   -> local, sin clave; lento sin GPU (el que usó S4)
LLM_PROVEEDOR=gemini
LLM_CLAVE=

# LLM_MODELO: dejarlo VACIO con gemini. Los nombres de modelo rotan seguido, asi
# que el sistema le pregunta a la API cual habilita tu clave y elige uno estable
# de la familia flash. Para ver la lista y fijar otro a mano:
#     python -m api.main --modelos
LLM_MODELO=
OLLAMA_URL=http://localhost:11434

TEMP_EXTRACCION=0
TEMP_EXPLICACION=0.2
MAX_TOKENS_EXTRACCION=900
MAX_TOKENS_EXPLICACION=1100
MAX_TOKENS_LISTADO=2200
MAX_INTENTOS=2

# ---------------------------------------------------------------- Comportamiento
# false = el asistente no escribe nada en el grafo (solo lectura, para demostrar)
ESCRITURA_HABILITADA=true
GUARDAR_TRAZAS=true
# Fecha contra la que se miden los vencimientos. Vacío = hoy.
# El PG2 usó 2026-10-05; poner esa fecha para reproducir sus resultados.
FECHA_EVALUACION=
